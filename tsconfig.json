{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"outDir": "./dist",
		"rootDir": "./src",
		"paths": {
			"@": ["./"]
		},
		"strict": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
	"strictPropertyInitialization": false
  
	},
	    "exclude": [
        "node_modules"
    ]
}
