		"@vitest/ui": "^4.0.16",
		"supertest": "^7.1.4",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
