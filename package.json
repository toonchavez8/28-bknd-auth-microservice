{
	"name": "28-bknd-auth-microservice",
	"version": "1.0.0",
	"description": "El objetivo es desarrollar un **microservicio backend** que proporcione funcionalidades esenciales de **autenticación de usuarios**.\r El sistema permitirá:",
	"main": "index.js",
	"scripts": {
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"start": "ts-node -r tsconfig-paths/register src/index.ts",
		"dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
		"build": "tsc",
		"serve": "node dist/index.js",
		"clean": "rm -rf node_modules dist package-lock.json",
		"reset-db": "ts-node -r tsconfig-paths/register src/utils/reset-db.ts"
	},
	"repository": {
